---
// Frame shared by every article page and its translations: back link, title,
// byline, links to the other languages, and the article typography. The page
// supplies the disclaimer (slot "disclaimer") and the body (default slot).
import Layout from '@layouts/Layout.astro';
import BackToTop from '@components/ui/BackToTop.astro';
import { languages, useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getArticle, articleHref } from '../data/articles';
import '../styles/article.css';

interface Props {
  id: string;
  lang: Lang;
  /** Short title for the browser tab. */
  tabTitle: string;
}

const { id, lang, tabTitle } = Astro.props;
const t = useTranslations(lang);
const article = getArticle(id);
const version = article.versions[lang]!;
const others = (Object.keys(article.versions) as Lang[]).filter((l) => l !== lang);
const articlesIndex = lang === 'en' ? '/articles/' : `/${lang}/articles/`;
---

<Layout lang={lang} title={`${tabTitle} | Kukai Solutions`} description={article.summary[lang]}>
  <main class="px-4">
    <div class="mb-4">
      <a
        href={articlesIndex}
        class="text-sm text-black dark:text-white opacity-50 hover:opacity-100 hover:text-orange transition-colors"
      >
        {t('articles.back')}
      </a>
    </div>

    <article class="article mx-auto max-w-3xl py-10">
      <header class="mb-10">
        <h1 class="font-monospace text-2xl font-bold leading-tight text-orange lg:text-4xl">{version.title}</h1>
        <span class="mb-4 mt-4 block h-1 w-10 bg-orange"></span>
        <p class="text-sm opacity-70">
          {lang === 'en' ? 'By' : 'Por'} <em>{article.author}</em>,
          <a href="mailto:rafael.monteiro@kukaisolutions.com">rafael.monteiro@kukaisolutions.com</a>
          · <strong>{article.date[lang]}</strong>
        </p>
        {
          others.length > 0 && (
            <p class="mt-2 text-sm opacity-70">
              {t('articles.otherLangs')}:{' '}
              {others.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={articleHref(article, l)} lang={l} hreflang={l}>{languages[l]}</a>
                </>
              ))}
            </p>
          )
        }
      </header>

      <slot name="disclaimer" />
      <slot />
    </article>
  </main>
  <BackToTop />
</Layout>
