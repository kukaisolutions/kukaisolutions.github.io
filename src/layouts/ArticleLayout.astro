---
// Frame shared by every article page and its translations: back link, title,
// byline, links to the other languages, and the article typography. The page
// supplies the disclaimer (slot "disclaimer") and the body (default slot).
import Layout from '@layouts/Layout.astro';
import BackToTop from '@components/ui/BackToTop.astro';
import { languages, useTranslations } from '@i18n/ui';
import type { Lang } from '@i18n/ui';
import { getArticle, articleHref } from '../data/articles';

interface Props {
  id: string;
  lang: Lang;
  /** Short title for the browser tab. */
  tabTitle: string;
}

const { id, lang, tabTitle } = Astro.props;
const t = useTranslations(lang);
const article = getArticle(id);
const version = article.versions[lang]!;
const others = (Object.keys(article.versions) as Lang[]).filter((l) => l !== lang);
const articlesIndex = lang === 'en' ? '/articles/' : `/${lang}/articles/`;
---

<Layout lang={lang} title={`${tabTitle} | Kukai Solutions`} description={article.summary[lang]}>
  <main class="px-4">
    <div class="mb-4">
      <a
        href={articlesIndex}
        class="text-sm text-black dark:text-white opacity-50 hover:opacity-100 hover:text-orange transition-colors"
      >
        {t('articles.back')}
      </a>
    </div>

    <article class="article mx-auto max-w-3xl py-10">
      <header class="mb-10">
        <h1 class="font-monospace text-2xl font-bold leading-tight text-orange lg:text-4xl">{version.title}</h1>
        <span class="mb-4 mt-4 block h-1 w-10 bg-orange"></span>
        <p class="text-sm opacity-70">
          {lang === 'en' ? 'By' : 'Por'} <em>{article.author}</em>,
          <a href="mailto:rafael.monteiro@kukaisolutions.com">rafael.monteiro@kukaisolutions.com</a>
          · <strong>{article.date[lang]}</strong>
        </p>
        {
          others.length > 0 && (
            <p class="mt-2 text-sm opacity-70">
              {t('articles.otherLangs')}:{' '}
              {others.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={articleHref(article, l)} lang={l} hreflang={l}>{languages[l]}</a>
                </>
              ))}
            </p>
          )
        }
      </header>

      <slot name="disclaimer" />
      <slot />
    </article>
  </main>
  <BackToTop />
</Layout>

<style is:global>
  .article {
    line-height: 1.75;
  }
  .article > p,
  .article li p {
    margin-bottom: 1.25rem;
    text-align: justify;
    hyphens: auto;
  }
  .article h2 {
    margin: 3rem 0 1rem;
    font-size: 1.5rem;
    line-height: 1.3;
    color: #e06330;
  }
  .article h3 {
    margin: 2rem 0 0.75rem;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .article a {
    color: #e06330;
  }
  .article a:hover {
    text-decoration: underline;
  }
  .article ol,
  .article ul {
    margin: 0 0 1.25rem 1.5rem;
  }
  .article ol {
    list-style: decimal;
  }
  .article ul {
    list-style: disc;
  }
  .article ul ul {
    margin-top: 0.5rem;
    list-style: circle;
  }
  .article li {
    margin-bottom: 0.5rem;
  }
  .article li::marker {
    color: #e06330;
  }
  .article li > p {
    margin-top: 0.75rem;
  }

  .article > p.disclaimer {
    margin-bottom: 0;
    font-size: 0.85rem;
    font-style: italic;
    opacity: 0.7;
  }

  .article .callout {
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid #e06330;
    border-radius: 0.375rem;
    background: rgba(224, 99, 48, 0.08);
  }
  .article .callout p {
    margin: 0;
  }
  .article .callout .callout-title {
    margin-bottom: 0.4rem;
    font-weight: 700;
    color: #e06330;
  }

  .article figure {
    margin: 2rem 0;
  }
  .article figure img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    padding: 1rem;
    border-radius: 0.5rem;
    /* images are transparent with dark strokes: keep them legible in dark mode */
    background: #fff;
  }
  .article figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.75;
    text-align: center;
  }

  .article .table-wrap {
    margin: 1.5rem 0 2rem;
    overflow-x: auto;
  }
  .article table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .article th,
  .article td {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid #d1d5db;
    text-align: left;
    vertical-align: top;
  }
  .article th {
    border-bottom: 2px solid #e06330;
    color: #e06330;
  }
  html.dark .article th,
  html.dark .article td {
    border-bottom-color: #374151;
  }
  html.dark .article th {
    border-bottom-color: #e06330;
  }

  .article hr {
    margin: 3rem 0 1rem;
    border-color: #d1d5db;
  }
  html.dark .article hr {
    border-color: #374151;
  }
  .article .references {
    font-size: 0.9rem;
  }
</style>
