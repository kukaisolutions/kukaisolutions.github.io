---
import Layout from '@layouts/Layout.astro';
import ArticlesList from '@components/ArticlesList.astro';
import BackToTop from '@components/ui/BackToTop.astro';

const lang = 'es' as const;
---

<Layout
  lang={lang}
  title="Artículos | Kukai Solutions"
  description="Artículos sobre gestión, tecnología y pequeñas empresas."
>
  <main class="px-4">
    <div class="mb-4">
      <a
        href="/es/"
        class="text-sm text-black dark:text-white opacity-50 hover:opacity-100 hover:text-orange transition-colors"
      >
        ← Volver al inicio
      </a>
    </div>
    <ArticlesList lang={lang} />
  </main>
  <BackToTop />
</Layout>
